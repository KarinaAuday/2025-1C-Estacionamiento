@model List<Persona>

<p>Busqueda de Personas por Apellido</p>
<form method="get" action='@Url.Action("Buscar" ,"Personas1")'>
   <input type = "text" name="apellido" placeholder="Apellido de la Persona" />
   <input type = "submit" value= "Buscar" />
</form>


@if (!String.IsNullOrEmpty(ViewBag.Mensaje))
{
    <p>@ViewBag.Mensaje</p>
}
@if (Model != null && Model.Count > 0)
{
    <h2>Resultado de la busqueda</h2>
    <ul>
        @foreach (var persona in Model)
        {
            <li>@persona.NombreCompleto</li>
            <li>@persona.Dni</li>
        }
    </ul>

}


<a>
    <a asp-action="Index">Volver al incio</a>
</a>